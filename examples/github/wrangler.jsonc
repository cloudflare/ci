{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ci-github",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "./Dockerfile",
      "max_instances": 10,
      "instance_type": "standard-4",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox",
      },
    ],
  },
  "workflows": [
    {
      "name": "cloudflare-ci-github",
      "binding": "CI_WORKFLOW",
      "class_name": "CI",
    },
  ],
  "exports": {
    "CiSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cloudflare-ci-github-backups",
    },
  ],

  "vars": {
    "BACKUP_BUCKET_NAME": "cloudflare-ci-github-backups",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
}
