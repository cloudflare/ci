{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["@cloudflare/workers-types", "@types/node", "vitest"]
  },
  "include": [
    "src/**/*.ts",
    "cloudflare.ci.ts",
    "env.ts",
    "worker-configuration.d.ts"
  ]
}
